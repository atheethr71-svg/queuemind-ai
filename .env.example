# ============================================================
# QueueMind AI - Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://queuemind:queuemind@postgres:5432/queuemind

# --- Security ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- AWS ---
# Leave blank to run in demo mode without AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=queuemind-uploads
AWS_SNS_TOPIC_ARN=

# --- Internal Service URLs ---
AI_ENGINE_URL=http://ai-engine:8001

# --- Frontend Public Variables ---
# These are exposed to the browser. Use localhost for local dev.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Demo Mode ---
# Set to true to enable simulated real-time data without real cameras/hardware
DEMO_MODE=true

# --- AI / ML ---
YOLO_MODEL_PATH=yolov8n.pt

# --- AI API Keys (use one of the following) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
